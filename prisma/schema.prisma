generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ANGLER
  GUEST
  ADMIN
}

enum NotificationType {
  // Booking lifecycle (Hybrid Flow)
  BOOKING_CREATED       // Angler: Booking request submitted (legacy - old flow)
  PAYMENT_AUTHORIZED    // Angler: Payment pre-authorized, awaiting captain approval (NEW)
  BOOKING_APPROVED      // Angler: Captain approved booking (legacy - old flow)
  PAYMENT_CAPTURED      // Angler: Payment captured, booking confirmed (NEW)
  BOOKING_CONFIRMED     // Angler: Booking confirmed (DIRECT flow)
  BOOKING_REJECTED      // Angler: Captain rejected booking
  PAYMENT_RELEASED      // Angler: Pre-authorized payment released (NEW)
  BOOKING_PAID          // Angler: Payment confirmed (legacy - old flow)
  BOOKING_CANCELLED     // Angler: Booking cancelled
  PAYMENT_REFUNDED      // Angler: Refund processed (NEW)
  
  // Review system
  REVIEW_SUBMITTED      // Angler: Review submitted for approval
  REVIEW_APPROVED       // Angler: Review approved and published
  REVIEW_REJECTED       // Angler: Review rejected by moderator
  
  // Account events
  ACCOUNT_VERIFIED      // Angler: Email verified
  PAYMENT_FAILED        // Angler: Payment processing failed
  
  // System
  SYSTEM_ANNOUNCEMENT   // Platform updates
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum PromoCodeType {
  PERCENTAGE  // e.g., 10% off
  FIXED       // e.g., RM50 off (future)
}

enum PromoCodeStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  EXHAUSTED   // Max uses reached
}

enum PromoCodeScope {
  UNIVERSAL     // Can be used by anyone (admin-created codes)
  REGISTRATION  // Auto-assigned on registration (like FISHONTRIP1)
  CHARTER       // Charter-specific codes (future)
  REFERRAL      // Referral codes (future)
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String? // Optional for OAuth users
  name          String? // Display name (NextAuth standard)
  firstName     String? // First name
  lastName      String? // Last name
  phone         String? // Phone number with country code
  bio           String?
  image         String? // Avatar URL (NextAuth standard)
  emailVerified DateTime? // NextAuth standard field
  role          UserRole  @default(ANGLER)

  // Address fields (Phase 2)
  streetAddress String?
  city          String?
  state         String?
  postcode      String?
  country       String? @default("Malaysia")

  // Emergency contact (Phase 2)
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  blogPosts                BlogPost[]
  comments                 BlogComment[]
  bookings                 Booking[]
  favorites                Favorite[] // Phase 2: Favorites system
  reviews                  Review[] // Phase 3: Reviews system
  accounts                 Account[] // OAuth accounts
  sessions                 Session[] // NextAuth sessions
  notifications            Notification[]
  notificationPreferences  NotificationPreferences?
  promoCodeAssignments     UserPromoCodeAssignment[]
}

// NextAuth OAuth Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth Verification Token model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model VerificationCode {
  id        String    @id @default(cuid())
  email     String
  code      String
  type      String // "TAC", "PASSWORD_RESET", etc.
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, type])
  @@index([code])
  @@index([expiresAt])
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  content         String
  coverImage      String?
  coverImageAlt   String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  authorId        String
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  readingTime     Int?
  viewCount       Int       @default(0)
  
  // Featured posts system
  featured        Boolean   @default(false)
  featuredOrder   Int?      // Optional: for controlling order of featured posts
  featuredAt      DateTime? // Track when post was featured

  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categories BlogCategory[] @relation("BlogPostToCategory")
  tags       BlogTag[]      @relation("BlogPostToTag")
  comments   BlogComment[]

  @@index([slug])
  @@index([published, publishedAt])
  @@index([authorId])
  @@index([featured, featuredAt])
}

model BlogCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[] @relation("BlogPostToCategory")

  @@index([slug])
}

model BlogTag {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  createdAt DateTime   @default(now())
  posts     BlogPost[] @relation("BlogPostToTag")

  @@index([slug])
}

model BlogComment {
  id        String   @id @default(cuid())
  content   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  postId    String

  author User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@index([approved])
}

model NewsletterSubscription {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([email])
  @@index([active])
}

// Booking system
enum BookingStatus {
  // Manual flow (Request & Approve)
  PENDING                // Awaiting captain approval (no payment yet)
  AWAITING_PAYMENT       // Approved, awaiting payment (48h deadline)
  
  // Auto flow (Instant Booking)
  PAYMENT_AUTHORIZED     // Payment secured, awaiting captain acknowledgment (12h deadline)
  
  // Common statuses
  PAID                   // Payment confirmed, trip confirmed
  UNDER_REVIEW           // Admin reviewing captain's request (manual dispute handling)
  COMPLETED              // Trip completed
  REJECTED               // Captain rejected
  CANCELLED              // Angler cancelled
  EXPIRED                // Deadline expired
}

enum BookingFlowType {
  MANUAL      // Request → Approval → Payment → Paid
  AUTO        // Payment → Acknowledgment → Paid
}

enum PayoutStatus {
  PENDING      // Payment received, payout not scheduled
  SCHEDULED    // Included in payout batch
  PROCESSING   // Bank transfer initiated
  COMPLETED    // Funds transferred
  FAILED       // Transfer failed
  ON_HOLD      // Flagged for review
}

enum RefundStatus {
  PENDING      // Refund requested
  PROCESSING   // Refund being processed
  COMPLETED    // Refund completed
  FAILED       // Refund failed (requires manual intervention)
}

model Booking {
  // === MAIN DETAIL ===
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // hold expires at (e.g., now + 12h)

  // === ANGLER'S DETAIL ===
  userId String // Required - references User with role ANGLER or GUEST
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // === BOOKING DETAIL ===
  tripId    String // References Trip.id in fishon-captain DB
  charterId String // References Charter.id in fishon-captain DB

  date      DateTime
  days      Int      // Number of days booked (not trip duration)
  startTime String? // e.g., "07:00" when trip has multiple start times
  
  // Time-based scheduling (Phase 2: Multi-trip support)
  // Stores array of individual trip instances with their exact time ranges
  // Example: 3-day booking of 4-hour trip starting at 8AM:
  // [
  //   { day: 1, date: "2025-11-13", startDateTime: "2025-11-13T08:00:00Z", endDateTime: "2025-11-13T12:00:00Z" },
  //   { day: 2, date: "2025-11-14", startDateTime: "2025-11-14T08:00:00Z", endDateTime: "2025-11-14T12:00:00Z" },
  //   { day: 3, date: "2025-11-15", startDateTime: "2025-11-15T08:00:00Z", endDateTime: "2025-11-15T12:00:00Z" }
  // ]
  // This allows:
  // - Accurate overlap detection (only blocks 8AM-12PM, not full days)
  // - Clear UI display of each trip slot
  // - Support for multi-day trips that span multiple calendar days (e.g., 48h trip)
  timeSlots Json? // Array of { day: number, date: string, startDateTime: string, endDateTime: string }
  
  // Guest counts stored as JSON for flexibility
  guests Json // { "adults": 2, "children": 1, "participants": [{name, phone, isBooker}] }

  // === PRICING BREAKDOWN ===
  tripPrice  Decimal @db.Decimal(10, 2) // Base trip price PER DAY at booking time (normal or promo)
  discount   Json? // { "code": "SUMMER10", "percentage": "10%", "amount": 50.00 }
  tax        Json? // { "name": "SST", "percentage": "6%", "amount": 30.00 } (future)
  finalPrice Decimal @db.Decimal(10, 2) // Total amount angler pays (includes platform fee, gateway fee, tax, minus discount)

  // === PROMO CODE ===
  promoCodeId String?
  promoCode   PromoCode? @relation("BookingPromoCode", fields: [promoCodeId], references: [id])

  // === BOOKING STATUS ===
  status             BookingStatus @default(PENDING)
  cancelledBy        String?       // Who cancelled: "ANGLER", "CAPTAIN", "SYSTEM", "ADMIN"
  cancellationReason String?
  rejectionReason    String?
  captainDecisionAt  DateTime?
  paidAt             DateTime?

  // === BOOKING FLOW (Dual-Flow System) ===
  bookingFlowType        BookingFlowType  // Which flow was used: MANUAL or AUTO
  
  // Deadlines (computed at booking creation based on flow)
  approvalDeadline       DateTime?        // MANUAL: Captain must approve by this time (PENDING status)
  paymentDeadline        DateTime?        // MANUAL: Angler must pay by this time (AWAITING_PAYMENT status)
  acknowledgmentDeadline DateTime?        // AUTO: Captain must acknowledge by this time (PAYMENT_AUTHORIZED status)
  
  // Admin review tracking (for manual dispute handling)
  reviewRequestedBy      String?          // User ID of captain who requested review
  reviewRequestedAt      DateTime?        // When review was requested
  reviewedBy             String?          // Staff user ID who resolved the review
  reviewedAt             DateTime?        // When review was completed
  reviewNotes            String?          @db.Text // Admin decision notes and reasoning

  // === PAYMENT TRACKING ===
  paymentTransactionId String? @db.VarChar(255) // Senang Pay transaction ID (legacy) OR Stripe charge ID
  paymentMethod        String? @db.VarChar(50)  // Payment method: "CARD", "FPX", "EWALLET", "MOCK"
  paymentFlow          String? @db.VarChar(50)  // Payment flow: "TOKENIZED" (card), "DIRECT" (FPX/ewallet)
  paymentNote          String? @db.Text         // Payment status/error messages
  
  // === HYBRID PAYMENT FLOW (Dual-Flow Support) ===
  paymentIntentId      String?   @db.VarChar(255) // Token ID (TOKENIZED) or booking ID (DIRECT)
  paymentAuthorizedAt  DateTime? // When card token was created (TOKENIZED only)
  paymentCapturedAt    DateTime? // When token was charged (TOKENIZED) or FPX/ewallet payment completed (DIRECT)
  paymentReleasedAt    DateTime? // When token was released without charge (TOKENIZED only)

  // === FINANCIAL TRACKING (Phase 1: Admin Finance Dashboard) ===
  platformFee      Decimal?      @db.Decimal(10, 2) // Fishon commission (10% of subtotal, where subtotal = tripPrice * days)
  serviceFee       Decimal?      @db.Decimal(10, 2) // Payment gateway charge (1.5% of subtotal + platformFee - discount)
  captainEarnings  Decimal?      @db.Decimal(10, 2) // Captain net earnings (subtotal - platformFee = tripPrice * days - platformFee)
  payoutStatus     PayoutStatus? @default(PENDING)
  payoutBatchId    String?                          // References Payout.batchId in fishon-captain DB
  
  // === REFUND TRACKING (Enhanced for Hybrid Flow) ===
  refundStatus         RefundStatus? // Refund processing status
  refundAmount         Decimal?      @db.Decimal(10, 2)
  refundedAt           DateTime?
  refundReason         String?       @db.Text
  refundedBy           String?       // Staff user ID who processed refund
  refundTransactionId  String?       @db.VarChar(255) // Gateway refund transaction ID
  cancellationPolicy   Json?         // Snapshot of policy at booking time

  // === CONVERSATION ===
  note            String? // Angler's initial note
  captainResponse String? // Captain's response (acceptance message, instructions, etc.)
  chatId          String? // Future: Link to chat conversation
  
  // Relations
  notifications   Notification[]
  conversation    Conversation? // 1:1 relationship

  @@index([userId])
  @@index([tripId])
  @@index([charterId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
  @@index([paymentIntentId])
  @@index([charterId, date, status])
  // Note: Partial unique constraint (only for PAID/PAYMENT_PENDING) not supported in Prisma
  // Race condition protection relies on:
  // 1. Serializable transaction isolation
  // 2. Conflict detection in application logic  
  // 3. Payment authorization acting as soft lock
}

// Chat & Messaging system
enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum ConversationStatus {
  LOCKED       // Booking PENDING/APPROVED (before payment)
  ACTIVE       // Booking PAID (full chat access)
  RESTRICTED   // Trip in progress, limited chat
  CLOSING_SOON // 24h review period
  CLOSED       // After review period
  ARCHIVED     // Manually archived by user
}

model Conversation {
  id         String   @id @default(cuid())

  // Booking relationship (1:1)
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Participants
  anglerId   String           // fishon-market User.id
  charterId  String           // fishon-captain Charter.id (for captain lookup)
  ownerId    String           // fishon-captain User.id (charter owner)

  // Status (starts LOCKED, unlocks on payment)
  status     ConversationStatus @default(LOCKED)

  // Last activity tracking
  lastMessageAt      DateTime?
  lastMessagePreview String?   @db.VarChar(200)
  lastMessageBy      String?   // userId

  // Unread counts (separate for each participant)
  anglerUnreadCount  Int @default(0)
  captainUnreadCount Int @default(0)

  // Closure tracking
  closedAt   DateTime?
  closedBy   String?   // "system" | userId

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  messages   Message[]

  @@index([anglerId, lastMessageAt])
  @@index([ownerId, lastMessageAt])
  @@index([charterId])
  @@index([status, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Sender identification
  senderId   String   // User.id from either app
  senderType String   // "angler" | "captain" | "system"
  senderName String   // Snapshot of display name

  // Content
  content     String   @db.Text
  contentType String   @default("text") // "text" | "system" | "booking_card"

  // System messages metadata
  systemType  String?  // "booking_created" | "booking_approved" | "payment_confirmed" | etc.

  // Booking card data (when contentType = "booking_card")
  bookingSnapshot Json? // Snapshot of booking details at message time

  // Quick reply indicator
  isQuickReply Boolean @default(false)

  // Read receipts
  status      MessageStatus @default(SENT)
  deliveredAt DateTime?
  readAt      DateTime?

  // Metadata
  metadata    Json?    // For future: reactions, edits, attachments

  // Soft delete (for moderation)
  deletedAt   DateTime?
  deletedBy   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([senderType])
  @@map("messages")
}

// Reviews & Ratings system (Phase 3)
model Review {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingId String @unique // One review per booking

  // Captain backend charter identifier (for aggregating reviews)
  captainCharterId String
  charterName      String

  // Overall rating (1-5 stars)
  overallRating Int // 1-5

  // Review badges (instead of category ratings)
  // Array of badge IDs from reviewBadges.ts
  // e.g., ["crew_mvp", "safety_first", "expert_guide"]
  badges String[] // Array of ReviewBadgeId

  // Review content
  comment String? // Optional text review

  // Media (photos AND videos)
  photos String[] // Array of photo URLs (no limit on photos)
  videos String[] // Array of video URLs (limit: 3 videos)

  // Moderation
  approved  Boolean @default(false) // Admin approval required
  published Boolean @default(false) // Visible on charter page

  // Metadata
  tripDate  DateTime // Date of the actual trip (from booking)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([captainCharterId])
  @@index([approved, published])
  @@index([createdAt])
}

// Favorites system (Phase 2)
model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Captain backend charter identifier
  captainCharterId String
  charterName      String
  location         String

  // Store charter snapshot for quick display
  charterData Json? // Full charter object for offline display

  // Optional angler notes
  notes String?

  addedAt DateTime @default(now())

  @@unique([userId, captainCharterId]) // Prevent duplicate favorites
  @@index([userId])
  @@index([addedAt])
}

// Notification system
model Notification {
  id          String             @id @default(cuid())
  userId      String
  type        NotificationType
  status      NotificationStatus @default(UNREAD)
  
  title       String
  message     String
  actionUrl   String?
  actionLabel String?
  
  // Related entities
  bookingId   String?
  charterId   String?
  reviewId    String?            // For review notifications
  
  // Metadata
  metadata    Json?              // Additional data specific to notification type
  
  // Timestamps
  createdAt   DateTime           @default(now())
  readAt      DateTime?
  archivedAt  DateTime?
  expiresAt   DateTime?          // Auto-delete old notifications
  
  // Relations
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking     Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("notifications")
}

model NotificationPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Email notification preferences (per type)
  emailBookingCreated      Boolean @default(true)
  emailPaymentAuthorized   Boolean @default(true) // NEW: Hybrid flow
  emailBookingApproved     Boolean @default(true)
  emailPaymentCaptured     Boolean @default(true) // NEW: Hybrid flow
  emailBookingRejected     Boolean @default(true)
  emailPaymentReleased     Boolean @default(true) // NEW: Hybrid flow
  emailBookingPaid         Boolean @default(true)
  emailBookingCancelled    Boolean @default(true)
  emailPaymentRefunded     Boolean @default(true) // NEW: Hybrid flow
  emailReviewSubmitted     Boolean @default(true)
  emailReviewApproved      Boolean @default(true)
  emailReviewRejected      Boolean @default(true)
  emailAccountVerified     Boolean @default(true)
  emailPaymentFailed       Boolean @default(true)
  emailSystemAnnouncement  Boolean @default(true)

  // Push/In-app notification preferences (per type)
  pushBookingCreated      Boolean @default(true)
  pushPaymentAuthorized   Boolean @default(true) // NEW: Hybrid flow
  pushBookingApproved     Boolean @default(true)
  pushPaymentCaptured     Boolean @default(true) // NEW: Hybrid flow
  pushBookingRejected     Boolean @default(true)
  pushPaymentReleased     Boolean @default(true) // NEW: Hybrid flow
  pushBookingPaid         Boolean @default(true)
  pushBookingCancelled    Boolean @default(true)
  pushPaymentRefunded     Boolean @default(true) // NEW: Hybrid flow
  pushReviewSubmitted     Boolean @default(true)
  pushReviewApproved      Boolean @default(true)
  pushReviewRejected      Boolean @default(true)
  pushAccountVerified     Boolean @default(true)
  pushPaymentFailed       Boolean @default(true)
  pushSystemAnnouncement  Boolean @default(true)

  // SMS notification preferences (per type) - NEW: SMS channel
  smsBookingCreated      Boolean @default(true)
  smsPaymentAuthorized   Boolean @default(true)
  smsBookingApproved     Boolean @default(true)
  smsPaymentCaptured     Boolean @default(true)
  smsBookingRejected     Boolean @default(true)
  smsPaymentReleased     Boolean @default(true)
  smsBookingPaid         Boolean @default(true)
  smsBookingCancelled    Boolean @default(true)
  smsPaymentRefunded     Boolean @default(true)
  smsReviewSubmitted     Boolean @default(true)
  smsReviewApproved      Boolean @default(true)
  smsReviewRejected      Boolean @default(true)
  smsAccountVerified     Boolean @default(true)
  smsPaymentFailed       Boolean @default(true)
  smsSystemAnnouncement  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Analytics & Tracking system
enum AnalyticsEventType {
  PROFILE_VIEW       // Captain profile page view
  CHARTER_VIEW       // Charter detail page view
  CHARTER_SEARCH     // Charter appeared in search results
  PHOTO_VIEW         // Photo clicked/viewed in gallery
  VIDEO_VIEW         // Video played
  CONTACT_CLICK      // Contact/inquiry button clicked
  BOOKING_STARTED    // Booking form opened
  BOOKING_SUBMITTED  // Booking request submitted
  REVIEW_VIEW        // Review section viewed
  SHARE_CLICKED      // Share button clicked
  PAYMENT_AUTHORIZED // Payment pre-authorized (TOKENIZED flow)
  PAYMENT_CAPTURED   // Payment captured (TOKENIZED flow)
  PAYMENT_RELEASED   // Payment token released without charge (TOKENIZED flow)
  PAYMENT_REFUNDED   // Payment refunded (DIRECT flow or post-capture)
}

model AnalyticsEvent {
  id         String               @id @default(cuid())
  eventType  AnalyticsEventType
  
  // Captain backend references (stored as strings since data is in different DB)
  charterId  String? // References Charter.id in fishon-captain DB
  ownerId    String? // References User.id in fishon-captain DB (charter owner)
  
  // User context
  userId     String? // fishon-market User.id for authenticated users
  sessionId  String? // Browser session for anonymous tracking
  
  // Event metadata
  metadata   Json? // Flexible storage for event-specific data
  
  // Referral tracking
  referrer   String? // HTTP referrer
  source     String? // Traffic source: 'search', 'direct', 'social', etc.
  
  // Technical details
  userAgent  String? // Browser user agent
  ipAddress  String? // Hashed IP for privacy
  
  createdAt  DateTime @default(now())
  
  @@index([charterId, createdAt])
  @@index([ownerId, createdAt])
  @@index([eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

// Promo Code System
model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "FISHONTRIP1", "SUMMER10"
  name        String   // Display name: "Welcome Bonus", "Summer Sale"
  description String?  // "Get 10% off your first trip"
  
  // Discount configuration
  type        PromoCodeType @default(PERCENTAGE)
  percentage  Int?     // For PERCENTAGE type (e.g., 10 for 10%)
  fixedAmount Decimal? @db.Decimal(10, 2) // For FIXED type (future)
  
  // Scope and eligibility
  scope       PromoCodeScope @default(UNIVERSAL)
  
  // Validity period
  startDate   DateTime
  endDate     DateTime
  
  // Usage limits
  maxUses     Int?     // Total times code can be used (null = unlimited)
  usesCount   Int      @default(0) // Current usage count
  maxUsesPerUser Int   @default(1) // Per-user limit (default: one-time use)
  
  // Eligibility rules
  minPurchase Decimal? @db.Decimal(10, 2) // Minimum booking amount
  maxDiscount Decimal? @db.Decimal(10, 2) // Maximum discount cap
  newUsersOnly Boolean @default(false) // Only for users with no completed bookings
  
  // Targeting (future - Phase 2)
  specificCharters String[] // Charter IDs (empty = all charters)
  
  // Status
  status      PromoCodeStatus @default(ACTIVE)
  
  // Tracking
  createdBy   String?  // Admin user ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  bookings    Booking[] @relation("BookingPromoCode")
  assignments UserPromoCodeAssignment[]
  
  @@index([code])
  @@index([status, endDate])
  @@index([scope])
}

// Track which users have been assigned which promo codes
model UserPromoCodeAssignment {
  id           String   @id @default(cuid())
  userId       String
  promoCodeId  String
  
  // Tracking
  assignedAt   DateTime @default(now())
  usedAt       DateTime? // When user redeemed the code
  usedInBookingId String? // Which booking used this code
  
  // Relations
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode    PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  
  @@unique([userId, promoCodeId]) // User can only be assigned each code once
  @@index([userId])
  @@index([promoCodeId])
}

// Promotional Campaign System
enum CampaignType {
  REGISTRATION_INCENTIVE  // Drive new registrations
  SEASONAL_PROMOTION      // Seasonal offers
  PARTNER_OFFER           // Partner/affiliate campaigns
  ANNOUNCEMENT            // System announcements
}

enum CampaignStatus {
  DRAFT       // Being configured
  ACTIVE      // Live and showing
  PAUSED      // Temporarily disabled
  COMPLETED   // Ended naturally
  ARCHIVED    // Archived for history
}

enum DismissalStrategy {
  SESSION_ONLY             // Dismissed for current session only
  SESSION_WITH_COOLDOWN    // Reappear after X days
  PERMANENT                // Never show again after dismissal
  MAX_DISMISSALS           // Stop after X dismissals
}

enum PlacementPosition {
  RIGHT_SIDEBAR   // Desktop sidebar (sticky)
  LEFT_SIDEBAR    // Left sidebar
  BOTTOM_FIXED    // Mobile bottom bar (fixed)
  TOP_BANNER      // Top page banner
  MODAL_CENTER    // Center modal overlay
  INLINE_CONTENT  // Inline with content
}

enum InteractionAction {
  IMPRESSION  // Banner shown
  CLICK       // User clicked CTA
  DISMISS     // User dismissed banner
  CONVERSION  // User completed target action (e.g., registered)
}

model PromotionalCampaign {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "reg-welcome-2025"
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  priority    Int      @default(50) // Higher = more important
  
  // Scheduling
  startDate   DateTime?
  endDate     DateTime?
  
  // Targeting rules
  targetGuests      Boolean @default(true)
  targetRegistered  Boolean @default(false)
  excludeRoles      UserRole[]
  allowedPages      String[] // e.g., ["search", "charter-detail", "home"]
  allowedDevices    String[] // e.g., ["DESKTOP", "MOBILE", "TABLET"]
  
  // Content (JSON for multi-language support)
  contentEn   Json // { title, subtitle, cta, benefits: [] }
  contentMy   Json // { title, subtitle, cta, benefits: [] }
  
  // Dismissal configuration
  dismissalStrategy   DismissalStrategy @default(SESSION_ONLY)
  cooldownDays        Int?  // For SESSION_WITH_COOLDOWN
  maxDismissals       Int?  // For MAX_DISMISSALS
  
  // Analytics aggregates
  impressions   Int @default(0)
  clicks        Int @default(0)
  conversions   Int @default(0)
  
  // Metadata
  createdBy   String?  // Admin user ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  placements    CampaignPlacement[]
  interactions  UserCampaignInteraction[]
  
  @@index([status, priority])
  @@index([code])
}

model CampaignPlacement {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    PromotionalCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  placementKey  String // e.g., "search-sidebar", "pre-checkout-modal"
  devices       String[] // ["DESKTOP"] or ["MOBILE", "TABLET"]
  position      PlacementPosition
  sticky        Boolean @default(false)
  
  // Display rules (JSON for flexibility)
  // Example: { showAfterScroll: 200, hideOnCheckout: false, maxViewsPerSession: 1 }
  displayRules  Json
  
  // Layout configuration (JSON)
  // Example: { variant: "CARD", width: "300px", maxHeight: "400px", className: "..." }
  layoutConfig  Json
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([campaignId, placementKey])
  @@index([campaignId])
}

model UserCampaignInteraction {
  id          String   @id @default(cuid())
  userId      String?  // Null for guest users
  sessionId   String   // Browser session ID (cookie-based)
  campaignId  String
  campaign    PromotionalCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  placementKey  String // Which placement was interacted with
  action        InteractionAction
  
  // Context metadata (JSON)
  // Example: { page: "/search", device: "MOBILE", locale: "en", ... }
  metadata    Json?
  
  createdAt   DateTime @default(now())
  
  @@index([userId, campaignId])
  @@index([sessionId, campaignId])
  @@index([campaignId, action, createdAt])
  @@index([sessionId, action, createdAt])
}

// SMS Log - Stores all SMS activities for monitoring and debugging
enum SMSLogStatus {
  PENDING    // SMS queued for sending
  SENT       // Successfully sent to provider
  DELIVERED  // Confirmed delivery (if provider supports)
  FAILED     // Send failed
  INVALID    // Invalid phone number or config
}

model SMSLog {
  id          String   @id @default(cuid())
  
  // Recipient info
  userId      String?  // User ID if authenticated (nullable for system SMS)
  phone       String   // Normalized phone number (60xxxxxxxxx)
  
  // Message details
  messageType String   // e.g., "BOOKING_CREATED", "BOOKING_APPROVED", etc.
  message     String   @db.Text // Full SMS message content
  
  // Provider response
  status      SMSLogStatus @default(PENDING)
  messageId   String?  // Provider message ID (from Exabytes response)
  errorCode   String?  // Provider error code
  errorMessage String? @db.Text // Error details
  
  // Request/Response metadata
  provider    String   @default("EXABYTES") // SMS provider name
  requestPayload  Json? // Request details (for debugging)
  responsePayload Json? // Raw provider response
  
  // Timing
  sentAt      DateTime? // When SMS was sent to provider
  deliveredAt DateTime? // When delivery was confirmed (if supported)
  createdAt   DateTime @default(now())
  
  // Related entities (optional)
  bookingId   String?  // Related booking if applicable
  notificationId String? // Related notification if triggered by notification service
  
  @@index([userId, createdAt])
  @@index([phone, createdAt])
  @@index([status, createdAt])
  @@index([messageType, createdAt])
  @@index([bookingId])
  @@map("sms_logs")
}

// Email Log - Track all email delivery attempts and status
// Used for debugging email delivery issues and monitoring
enum EmailStatus {
  PENDING    // Email queued for sending
  SENT       // Successfully sent to provider
  DELIVERED  // Delivery confirmed (if webhook configured)
  FAILED     // Failed to send
  BOUNCED    // Email bounced
}

enum EmailProvider {
  RESEND     // Resend API (primary)
  SMTP       // Nodemailer SMTP (fallback)
}

enum EmailType {
  VERIFICATION_CODE     // Email verification (registration, login, guest booking)
  BOOKING_CREATED       // Booking request received
  BOOKING_APPROVED      // Captain approved booking
  BOOKING_REJECTED      // Captain rejected booking
  BOOKING_CONFIRMED     // Payment confirmed
  BOOKING_CANCELLED     // Booking cancelled
  BOOKING_REMINDER      // Upcoming trip reminder
  PAYMENT_REMINDER      // Payment deadline reminder
  WELCOME               // Welcome email after registration
  PASSWORD_CHANGED      // Password change notification
  PASSWORD_RESET        // Password reset code
  CAPTAIN_NOTIFICATION  // Notification to captain
  OTHER                 // Other email types
}

model EmailLog {
  id          String       @id @default(cuid())
  
  // Recipient info
  to          String       @db.VarChar(255)
  subject     String       @db.VarChar(500)
  
  // Email classification
  emailType   EmailType    @default(OTHER)
  
  // Delivery status
  status      EmailStatus  @default(PENDING)
  provider    EmailProvider
  
  // Provider response
  messageId   String?      @db.VarChar(255) // Resend ID or SMTP message ID
  errorCode   String?      @db.VarChar(100) // Error code if failed
  errorMessage String?     @db.Text         // Full error message
  
  // Retry tracking
  attempts    Int          @default(1)
  usedFallback Boolean     @default(false)  // True if SMTP fallback was used
  
  // Timing
  sentAt      DateTime?    // When successfully sent
  createdAt   DateTime     @default(now())
  
  // Related entities (optional)
  userId      String?      // User.id if sent to registered user
  bookingId   String?      // Related booking if applicable
  
  // Request metadata (for debugging)
  metadata    Json?        // Additional context (IP, user agent, etc.)
  
  @@index([to, createdAt])
  @@index([status, createdAt])
  @@index([emailType, createdAt])
  @@index([provider, createdAt])
  @@index([userId, createdAt])
  @@index([bookingId])
  @@map("email_logs")
}

// Payment Session - Stores booking data before DIRECT payment completion
// Used for AUTO flow + DIRECT payment (FPX/E-wallet) where booking is created after payment
model PaymentSession {
  id        String   @id @default(cuid())
  userId    String?  // Nullable for guest bookings
  
  // Booking data (stored as JSON for flexibility)
  bookingData Json   // Contains all booking details needed to create booking
  
  // Payment details
  amount      Decimal  @db.Decimal(10, 2)
  paymentMethod String @db.VarChar(50) // FPX, EWALLET
  
  // Status tracking
  status      String   @default("PENDING") @db.VarChar(50) // PENDING, COMPLETED, EXPIRED, FAILED
  
  // Lifecycle
  createdAt   DateTime @default(now())
  expiresAt   DateTime // Payment session expires after 30 minutes
  completedAt DateTime? // When payment was confirmed
  
  @@index([id, status])
  @@index([userId, createdAt])
  @@index([expiresAt])
}
